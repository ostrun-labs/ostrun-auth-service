{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Thykimik/ostrun-auth-service/contracts/ostrun/auth/UserRegistered.v1.json",
  "title": "Ostrun.Auth.UserRegistered",
  "version": 1,
  "description": "Publié quand un nouvel utilisateur s'inscrit avec succès sur le service Auth.",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid",
      "description": "Identifiant unique de l'utilisateur créé"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Adresse email utilisée pour l'inscription"
    },
    "registeredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Horodatage UTC de l'inscription (ISO 8601)"
    }
  },
  "required": ["userId", "email", "registeredAt"],
  "additionalProperties": false
}
