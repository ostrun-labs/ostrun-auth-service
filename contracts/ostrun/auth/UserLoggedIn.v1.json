{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ostrun-labs/ostrun-auth-service/contracts/ostrun/auth/UserLoggedIn.v1.json",
  "title": "Ostrun.Auth.UserLoggedIn",
  "version": 1,
  "description": "Published when a user successfully logs in on the Auth service.",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid",
      "description": "Identifier of the logged-in user"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address used to log in"
    },
    "loggedInAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of the login (ISO 8601)"
    }
  },
  "required": ["userId", "email", "loggedInAt"],
  "additionalProperties": false
}
