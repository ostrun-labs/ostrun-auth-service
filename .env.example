# Postgres (used by both the "postgres" and "api" services in docker-compose.yml)
POSTGRES_USER=ostrun_auth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ostrun_auth

# Api
ASPNETCORE_URLS=http://+:8080

# JWT. RSA private key (2048 bits or more), base64-encoded PEM on one line.
# Generate one per instance and never reuse it:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl base64 -A
# Other services verify tokens with the public key at /auth/.well-known/jwks.json.
JWT_SIGNING_KEY=
JWT_ISSUER=OstrunAuth
JWT_AUDIENCE=OstrunAuth
JWT_EXPIRATION_MINUTES=60

# RabbitMq. Absent/empty Host means events publish over MassTransit's
# in-memory transport instead (no broker required to run this service alone).
RabbitMq__Host=
RabbitMq__VirtualHost=/
RabbitMq__Username=guest
RabbitMq__Password=guest

# Google sign-in (optional). Set both to enable it, or leave both empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
