# Postgres (used by both the "postgres" and "api" services in docker-compose.yml)
POSTGRES_USER=ostrun_auth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ostrun_auth

# Api
ASPNETCORE_URLS=http://+:8080

# JWT — generate a real secret per instance, never reuse this value.
# e.g. openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=OstrunAuth
JWT_AUDIENCE=OstrunAuth
JWT_EXPIRATION_MINUTES=60

# Events — JSON array of {"event", "url"} subscribers for the Auth -> Mailer HTTP spike.
# Empty/absent by default for a standalone run (no subscribers, nothing gets posted).
# e.g. Events__Subscriptions=[{"event":"Ostrun.Auth.UserRegistered","url":"http://mailer-api:8080/events/ostrun.auth.user-registered"}]
Events__Subscriptions=
