{
  "provider": "Ostrun",
  "service": "auth",
  "version": "0.1.0",
  "displayName": "Ostrun Auth",
  "description": "Ostrun reference authentication service: JWT registration and login.",
  "repository": "https://github.com/Thykimik/ostrun-auth-service",
  "registry": null,
  "needsDb": true,
  "basePath": "/auth",
  "events": {
    "published": [
      "Ostrun.Auth.UserRegistered",
      "Ostrun.Auth.UserLoggedIn"
    ],
    "consumed": []
  },
  "dependencies": [],
  "env": [
    {
      "name": "ASPNETCORE_URLS",
      "required": true,
      "description": "Kestrel listen URL(s), e.g. http://+:8080"
    },
    {
      "name": "ConnectionStrings__Auth",
      "required": true,
      "description": "PostgreSQL connection string (Npgsql)"
    },
    {
      "name": "Jwt__SigningKey",
      "required": true,
      "description": "RSA private key (2048+ bits) as base64-encoded PEM, generate one per instance. Its public half is served at /auth/.well-known/jwks.json"
    },
    {
      "name": "Jwt__Issuer",
      "required": true,
      "description": "JWT issuer (iss)"
    },
    {
      "name": "Jwt__Audience",
      "required": true,
      "description": "JWT audience (aud)"
    },
    {
      "name": "Jwt__ExpirationMinutes",
      "required": false,
      "description": "Token validity in minutes (default: 60)"
    },
    {
      "name": "RabbitMq__Host",
      "required": false,
      "description": "RabbitMQ host. If absent, events publish over the in-memory transport (no broker required standalone)"
    },
    {
      "name": "RabbitMq__VirtualHost",
      "required": false,
      "description": "RabbitMQ virtual host (default: /)"
    },
    {
      "name": "RabbitMq__Username",
      "required": false,
      "description": "RabbitMQ username (default: guest)"
    },
    {
      "name": "RabbitMq__Password",
      "required": false,
      "description": "RabbitMQ password (default: guest)"
    }
  ],
  "ports": [
    {
      "containerPort": 8080,
      "protocol": "http",
      "description": "HTTP API"
    }
  ],
  "healthCheck": {
    "path": "/health",
    "method": "GET"
  }
}
